# Server port (default 3000)
PORT=3000

# Groq API Key for AI follow-up questions and scrapbook summaries.
# Optional - if not provided, the app uses intelligent local fallbacks.
# NEVER commit your real .env file.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database file location (defaults to memoria.sqlite)
DB_PATH=memoria.sqlite
